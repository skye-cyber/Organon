{
  "name": "organon-reader",
  "version": "1.0.0",
  "description": "Aristotle's Organon - Premium Digital Book Reader",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build": "tsc && vite build",
    "build:tauri": "tauri build",
    "preview": "vite preview",
    "cert:gen": "keytool -genkey -v -keystore ~/organon-upload-keystore.jks -alias organon -keyalg RSA -keysize 2048 -validity 10000"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@xenova/transformers": "^2.17.2",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.6.3",
    "vite": "^6.1.0"
  }
}
